# =============================================================================
# Admin Apotek E-commerce - Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Required)
# -----------------------------------------------------------------------------
# Dapatkan dari: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-key

# -----------------------------------------------------------------------------
# Midtrans Payment Gateway (Required untuk payment)
# -----------------------------------------------------------------------------
# Server Key dari Midtrans Dashboard > Settings > Access Keys
# Untuk production: gunakan key production
# Untuk testing: gunakan key sandbox
MIDTRANS_SERVER_KEY=your-midtrans-server-key

# Set 'true' untuk production, 'false' untuk sandbox/testing
MIDTRANS_IS_PRODUCTION=false

# Client Key (diperlukan untuk Snap frontend integration)
MIDTRANS_CLIENT_KEY=your-midtrans-client-key

# -----------------------------------------------------------------------------
# Biteship Logistics (Required untuk shipping)
# -----------------------------------------------------------------------------
# API Key dari Biteship Dashboard > Settings > API Key
# Untuk testing: gunakan mode testing (biteship_test.*)
# Untuk production: gunakan live key (biteship_live.*)
BITESHIP_API_KEY=your-biteship-api-key

# -----------------------------------------------------------------------------
# Shop Shipping Configuration (Required untuk Biteship)
# -----------------------------------------------------------------------------
# Nama toko/merchant untuk label pengiriman
SHOP_SHIPPER_NAME=ApotekECC

# Nomor HP untuk label pengiriman
SHOP_SHIPPER_PHONE=081234567890

# Alamat toko lengkap (untuk berat volume calculation)
# Format: Jalan, Kota, Provinsi, Kode Pos
SHOP_ADDRESS=Jl. Contoh No. 123, Jakarta Selatan, DKI Jakarta, 12345

# -----------------------------------------------------------------------------
# Google Maps API (Required untuk map location picker)
# -----------------------------------------------------------------------------
# Dapatkan dari: Google Cloud Console > APIs & Services > Credentials
# Pastikan Places API dan Maps JavaScript API sudah di-enable
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key