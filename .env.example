# =============================================================================
# Admin Apotek E-commerce - Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Required)
# -----------------------------------------------------------------------------
# Dapatkan dari: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-key

# -----------------------------------------------------------------------------
# Midtrans Payment Gateway
# -----------------------------------------------------------------------------
# Server-side Midtrans secrets and mode are managed in Admin Settings > Payment
# through database-backed runtime config and Vault keys such as
# `midtrans.server_key` and `midtrans.is_production`.
# Do not configure them as local Edge Function env secrets.
# Client Key (diperlukan untuk Snap frontend integration)
MIDTRANS_CLIENT_KEY=your-midtrans-client-key

# -----------------------------------------------------------------------------
# Biteship Logistics
# -----------------------------------------------------------------------------
# Biteship secrets and shipping provider config are managed in Admin Settings > Shipping
# through database-backed runtime config and Vault keys such as `biteship.api_key`.
# Do not configure them as local Edge Function env secrets.

# -----------------------------------------------------------------------------
# Shop Shipping Configuration
# -----------------------------------------------------------------------------
# Shop shipper and address values are managed in Admin Settings > Shipping
# through database-backed runtime config. Configure these keys there instead of
# local env variables: `shop.shipper_name`, `shop.shipper_phone`,
# `shop.shipper_email`, `shop.address`, `shop.organization`,
# `biteship.origin_postal_code`, `biteship.origin_area_id`,
# `biteship.origin_latitude`, `biteship.origin_longitude`, and
# `biteship.enabled_couriers`.

# -----------------------------------------------------------------------------
# Google Maps API (Required untuk map location picker)
# -----------------------------------------------------------------------------
# Dapatkan dari: Google Cloud Console > APIs & Services > Credentials
# Pastikan Places API dan Maps JavaScript API sudah di-enable
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
